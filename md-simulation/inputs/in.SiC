# LAMMPS input template — substituted by gen_inputs.py
# Material: SiC  | KIM: Tersoff_LAMMPS_ErhartAlbe_2005_SiC__MO_903987585848_005

units           metal
atom_style      charge
boundary        p p p

kim init Tersoff_LAMMPS_ErhartAlbe_2005_SiC__MO_903987585848_005 metal

read_data       lammps_init/SiC.lmp

kim interactions Si C

# comm_modify     cutoff 8.0

# === Геометрическая минимизация ===
min_style       cg
minimize        1e-13 1e-13 20000 20000

# === Мягкий разогрев (NVE + Langevin) ===
timestep        0.0005
velocity        all create 10 4928459 rot yes
velocity        all zero linear
fix             fxnve all nve
fix             fxlang all langevin 10 10 0.5 48279
run             20000

# === Прогрев 10 -> 300 K (NPT) ===
unfix           fxnve
unfix           fxlang
fix             fxmom all momentum 100 linear 1 1 1
fix             fxnpt all npt temp 10 300 0.1 aniso 0.0 0.0 1.0
timestep	0.001
run             30000
unfix           fxnpt

# === Равновесие при 300 K (NPT aniso, 200 пс) ===
# Ячейка должна выйти на плато: lx, ly, lz и press стабильны.
# Контролируй thermo-вывод перед тем как переходить к съёму.
thermo          500
thermo_style    custom step temp press vol lx ly lz pe etotal

fix             fxnpt_eq all npt temp 300 300 0.1 aniso 0.0 0.0 1.0
run             30000
unfix           fxnpt_eq

# === Основной съём (NVT, 300 K, 200 пс) ===
# NVT с зафиксированной равновесной ячейкой: чистые координатные флуктуации
# без смешивания с флуктуациями объёма.
fix             fxnvt all nvt temp 300 300 0.1
dump            mydmp all custom 500 dumps/dump.SiC id type x y z vx vy vz
dump_modify     mydmp sort id
run             70000
unfix           fxnvt
unfix           fxmom
